# Force LF line endings for all files on checkout (Linux Lambda compatibility)
* text=auto eol=lf

# Explicitly enforce LF for shell scripts and Python
*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
